# ─── Database ────────────────────────────────────────────────
# Local (Docker compose): mongodb://mongodb:27017/zest-pasticceria
# Dokploy: mongodb://<mongodb-service>:27017/zest-pasticceria o MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/zest-pasticceria

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
# Secreto para crear el admin por API (POST /api/auth/ensure-admin)
BOOTSTRAP_SECRET=your_bootstrap_secret_here

# ─── Stripe (runtime, API routes) ────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Google OAuth (opcional) ─────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── URL pública ─────────────────────────────────────────────
# Solo se usa en el servidor (redirects de Google OAuth). El cliente
# llama a la API con rutas relativas (/api), así que no causa conexiones
# fallidas ni depende del dominio. En Dokploy pon el dominio real.
NEXT_PUBLIC_URL=http://localhost:3000

# ─── Email (SMTP) ────────────────────────────────────────────
# Alternativa a Admin > Configuración > Email. Si están configurados
# en la DB (StoreConfig) ganan estos valores.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_...
SMTP_SECURE=true
STORE_EMAIL=hello@zestpasticceria.com

# ─── Docker compose (local) ──────────────────────────────────
APP_PORT=3000
